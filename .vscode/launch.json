    "version": "0.2.0",
    "configurations": [
        {
            "name": "target-bigquery",
            "type": "debugpy",
            "request": "launch",
            "justMyCode": false,
            "program": "../target_bigquery/__init__.py",
            "cwd": "${workspaceFolder}/.secrets",
            "args": [
                "<",
                "./etl-output/data3.singer",
                "--config",
                "config.json",
                "--tables",
